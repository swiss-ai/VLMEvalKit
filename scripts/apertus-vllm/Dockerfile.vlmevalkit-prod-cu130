FROM docker.io/nvidia/cuda:13.0.0-cudnn-devel-ubuntu24.04

ARG DEBIAN_FRONTEND=noninteractive
ARG MAX_JOBS=8
ARG CUDA_VERSION_PATH=cu130
ARG PYTHON_VERSION=3.12
ARG VLLM_VERSION=0.19.0
ARG VLLM_BRANCH=apertus-lmms-eval
ARG VLLM_MAIN_CUDA_VERSION=13.0

ENV TORCH_CUDA_ARCH_LIST="9.0a" \
    MAX_JOBS="${MAX_JOBS}" \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    UV_HTTP_TIMEOUT=500 \
    UV_INDEX_STRATEGY=unsafe-best-match \
    UV_LINK_MODE=copy \
    VLLM_USE_PRECOMPILED=1 \
    VLLM_ALLOW_LONG_MAX_MODEL_LEN=1 \
    VLLM_MAIN_CUDA_VERSION="${VLLM_MAIN_CUDA_VERSION}" \
    VLLM_PRECOMPILED_WHEEL_VARIANT="${CUDA_VERSION_PATH}"

# Keep host NVIDIA driver libraries first to avoid loading CUDA compatibility
# stubs from /usr/local/cuda/compat on GH200 nodes.
ENV LD_LIBRARY_PATH=/usr/local/nvidia/lib:/usr/local/nvidia/lib64:/usr/lib

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

WORKDIR /opt

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash bash-completion ca-certificates ccache curl git less vim-tiny \
    build-essential cmake ninja-build pkgconf \
    ffmpeg openjdk-17-jre-headless \
    libgl1 libglib2.0-0 libibverbs-dev libnuma1 libnuma-dev \
    python3 python3-dev python3-pip python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN curl -LsSf https://astral.sh/uv/install.sh | sh

RUN python3 -m venv /opt/venv
ENV VIRTUAL_ENV="/opt/venv"
ENV PATH="/opt/venv/bin:/root/.local/bin:${PATH}"

RUN python --version && python -m pip --version && uv --version && java -version

RUN python -m pip install --upgrade \
    pip \
    wheel \
    "setuptools>=77.0.3,<81.0.0"

RUN uv pip install --python /opt/venv/bin/python \
        --index-url https://download.pytorch.org/whl/${CUDA_VERSION_PATH} \
        torch==2.10.0 \
        torchvision==0.25.0 \
        torchaudio==2.10.0 && \
    uv pip install --python /opt/venv/bin/python \
        "packaging>=24.2" \
        ninja \
        "cmake>=3.26.1" \
        "setuptools-scm>=8" \
        "jinja2>=3.1.6" \
        regex \
        build \
        "protobuf>=5.29.6,!=6.30.*,!=6.31.*,!=6.32.*,!=6.33.0.*,!=6.33.1.*,!=6.33.2.*,!=6.33.3.*,!=6.33.4.*" \
        "ray[default]" && \
    python - <<'PY'
import torch
print("Torch:", torch.__version__)
print("Torch CUDA:", torch.version.cuda)
PY

# CUDA 13 compatibility: expose cuDNN/NCCL headers where extension builds can find them.
RUN CUDNN_DIR=$(dirname "$(find /usr -name cudnn.h -print -quit)") && \
    find "${CUDNN_DIR}" -maxdepth 1 -name 'cudnn*.h' -exec ln -sf {} /opt/venv/include/ \; && \
    NCCL_H=$(find /opt/venv/lib/python${PYTHON_VERSION}/site-packages -path '*/nvidia/nccl/include/nccl.h' -print -quit) && \
    if [ -n "${NCCL_H}" ]; then ln -sf "${NCCL_H}" /opt/venv/include/nccl.h; fi

WORKDIR /workspace

RUN git clone https://github.com/swiss-ai/vllm.git /workspace/vllm && \
    cd /workspace/vllm && \
    git checkout "${VLLM_BRANCH}" && \
    echo "vLLM branch: ${VLLM_BRANCH}" && \
    echo "vLLM commit: $(git rev-parse HEAD)"

COPY external/Emu3.5 /workspace/Emu3.5
COPY external/benchmark-audio-tokenizer /workspace/benchmark-audio-tokenizer

ENV VLLM_REPO=/workspace/vllm \
    EMU35=/workspace/Emu3.5 \
    WAVTOKENIZER=/workspace/benchmark-audio-tokenizer/src/repos/wavtokenizer \
    PYTHONPATH=/workspace/VLMEvalKit:/workspace/vllm:/workspace/benchmark-audio-tokenizer:${PYTHONPATH} \
    LD_LIBRARY_PATH=${LD_LIBRARY_PATH}:/opt/venv/lib/python3.12/site-packages/torch/lib \
    VLLM_APERTUS_EMU35_CODEBASE=/workspace/Emu3.5 \
    VLLM_APERTUS_AUDIO_TOKENIZER_CODEBASE=/workspace/benchmark-audio-tokenizer

WORKDIR /workspace/vllm

RUN set -eu; \
    export UV_CACHE_DIR="${UV_CACHE_DIR:-/tmp/uv-cache}"; \
    mkdir -p "${UV_CACHE_DIR}"; \
    export VLLM_PRECOMPILED_WHEEL_VARIANT="${VLLM_PRECOMPILED_WHEEL_VARIANT:-cu130}"; \
    export VLLM_MAIN_CUDA_VERSION="${VLLM_MAIN_CUDA_VERSION:-13.0}"; \
    export VLLM_PRECOMPILED_WHEEL_LOCATION="${VLLM_PRECOMPILED_WHEEL_LOCATION:-https://github.com/vllm-project/vllm/releases/download/v${VLLM_VERSION}/vllm-${VLLM_VERSION}+cu130-cp38-abi3-manylinux_2_35_aarch64.whl}"; \
    if [ -z "${VLLM_PRECOMPILED_WHEEL_COMMIT:-}" ] && VLLM_GIT_COMMIT="$(git -C "${VLLM_REPO}" rev-parse HEAD 2>/dev/null)"; then \
      export VLLM_PRECOMPILED_WHEEL_COMMIT="${VLLM_GIT_COMMIT}"; \
    fi; \
    VLLM_USE_PRECOMPILED=1 uv pip install \
      --python /opt/venv/bin/python \
      --reinstall-package vllm \
      --no-build-isolation \
      --editable . \
      --torch-backend=auto

RUN python - <<'PY'
import torch

print(f"Torch runtime: {torch.__version__} (CUDA {torch.version.cuda})")
try:
    import vllm._C  # noqa: F401
except Exception as exc:
    if "libcuda.so.1" in str(exc):
        print("Skipping strict vllm._C import check during image build: libcuda.so.1 is unavailable.")
    else:
        raise
else:
    print("vLLM native extension import check passed.")
PY

COPY . /workspace/VLMEvalKit
WORKDIR /workspace/VLMEvalKit

RUN python - <<'PY'
from pathlib import Path
import re

skip = {
    "antlr4-python3-runtime",
    "cd-fvd",
    "decord",
    "dotenv",
    "torch",
    "torchaudio",
    "torchvision",
}
lines = []
for line in Path("requirements.txt").read_text().splitlines():
    stripped = line.strip()
    if not stripped or stripped.startswith("#"):
        continue
    name = re.split(r"[<>=!~; \[]", stripped, maxsplit=1)[0].lower()
    if name in skip:
        continue
    lines.append(stripped)
Path("/tmp/vlmevalkit-image-requirements.txt").write_text("\n".join(lines) + "\n")
print("Installing", len(lines), "VLMEvalKit dependency entries")
PY

RUN uv pip install --python /opt/venv/bin/python \
      --no-build-isolation \
      -r /tmp/vlmevalkit-image-requirements.txt && \
    uv pip install --python /opt/venv/bin/python \
      --no-deps \
      --editable /workspace/VLMEvalKit && \
    uv pip install --python /opt/venv/bin/python --reinstall \
      "protobuf>=5.29.6,!=6.30.*,!=6.31.*,!=6.32.*,!=6.33.0.*,!=6.33.1.*,!=6.33.2.*,!=6.33.3.*,!=6.33.4.*" \
      antlr4-python3-runtime==4.9.3 && \
    uv pip install --python /opt/venv/bin/python \
      "scipy>=1.10" \
      "pyyaml>=6.0" \
      "soundfile>=0.12" \
      "einops>=0.6.1" \
      "beautifulsoup4>=4.12"

# OmniDocBench / OceanOCRBench need WordNet at eval time. Bake it into the
# image so jobs don't re-download it every run.
RUN python -c "import nltk; nltk.download('wordnet', download_dir='/usr/share/nltk_data', quiet=True)"

# Marker file used by scripts/apertus-vllm/eval_job.slurm to short-circuit the
# legacy-image overlay (pip install bs4/nltk + wordnet download workarounds).
# When this file is present the overlay is a no-op.
RUN echo "apertus-vlmeval-cu130 $(date -u +%Y-%m-%dT%H:%M:%SZ)" > /etc/apertus_image_version

RUN python - <<'PY'
import os
import torch
import vllm
from vlmeval.config import supported_VLM
from vlmeval.dataset import SUPPORTED_DATASETS
from src.audio_tokenizers.implementations.wavtokenizer import WavTokenizer40

assert torch.__version__.startswith("2.10.0"), torch.__version__
assert str(torch.version.cuda).startswith("13."), torch.version.cuda
assert getattr(vllm, "__version__", "").startswith("0.19."), getattr(vllm, "__version__", "unknown")
assert "Apertus-1p5-8B" in supported_VLM
assert "3DSRBench" in SUPPORTED_DATASETS
assert os.environ["VLLM_APERTUS_AUDIO_TOKENIZER_CODEBASE"] == "/workspace/benchmark-audio-tokenizer"
assert WavTokenizer40.name == "wavtokenizer-40"
print("VLMEvalKit Apertus image validation passed.")
print("vLLM:", vllm.__version__)
PY

RUN printf '%s\n' \
    'Apertus VLMEvalKit CUDA 13 image.' \
    'Included paths:' \
    '  /workspace/VLMEvalKit' \
    '  /workspace/vllm' \
    '  /workspace/Emu3.5 (EMU35)' \
    '  /workspace/benchmark-audio-tokenizer (VLLM_APERTUS_AUDIO_TOKENIZER_CODEBASE)' \
    '  /workspace/benchmark-audio-tokenizer/src/repos/wavtokenizer (WAVTOKENIZER)' \
    > /etc/motd
